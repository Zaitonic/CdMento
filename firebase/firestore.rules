rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regular users can read/write only their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin-only collections – only authenticated admins may read/write
    match /admin/access_logs/{docId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    match /admin/activity_logs/{docId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    match /admin/feedback_support/{docId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    match /admin/error_logs/{docId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}