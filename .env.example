AUTH_MODE=local
DATA_BACKEND=sqlite
# To use cloud accounts: AUTH_MODE=firebase, DATA_BACKEND=firestore,
# and provide Application Default Credentials on the server.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Optional durable external worker; run Celery worker and beat when set.
REDIS_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# AI — server-side only. Use free-plan provider accounts only.
# AI_ENABLED=false is the immediate off switch.
AI_ENABLED=true
AI_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional third provider. Explicit :free variant required; paid fallback is rejected.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional Cloudflare backup: Workers Free only, no prepaid/unified billing.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_FREE_TIER_CONFIRMED=false
AI_DAILY_REQUESTS=100
AI_MAX_OUTPUT_TOKENS=2400

# Offline CPU OCR for scanned PDF pages; no API key or document upload required.
OCR_ENABLED=true
OCR_MAX_PAGES=100

# Local experimental FreeLLMAPI route: pinned to Mistral, never auto.
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_MODEL=ministral-8b-latest
FREELLMAPI_FREE_TIER_CONFIRMED=false
