# ==============================================================================
# CdMento Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION & DATABASE
# ------------------------------------------------------------------------------
AUTH_MODE=google
DATA_BACKEND=sqlite
GOOGLE_CLIENT_ID=789128091815-5t819mjiio02julj5ni5hepmjg8cagr2.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=789128091815-5t819mjiio02julj5ni5hepmjg8cagr2.apps.googleusercontent.com
APP_BASE_URL=http://localhost:5173

# Brevo transactional email (required for signup verification and password resets)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CdMento

# ------------------------------------------------------------------------------
# 2. AI GATEWAY (Server-Side)
# ------------------------------------------------------------------------------
AI_ENABLED=true
AI_FREE_TIER_CONFIRMED=false
AI_DAILY_REQUESTS=100
AI_MAX_OUTPUT_TOKENS=2400
AI_PROVIDER_ORDER=
AI_MAX_FAILOVER_ATTEMPTS=5
AI_REQUEST_TIMEOUT_SECONDS=45

# Cloudflare Workers AI (Workers Free)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_FREE_TIER_CONFIRMED=false

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (Requires an explicit :free model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional OpenAI-compatible free-tier presets (server-side only)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Optional JSON array of any additional OpenAI-compatible providers.
# EXTRA_AI_PROVIDERS_JSON=[{"name":"freellmapi-remote","base_url":"https://example.com/v1","api_key":"server-key","model":"model-name","enabled":true,"timeout_seconds":30,"extra_headers":{}}]
EXTRA_AI_PROVIDERS_JSON=

# Optional FreeLLMAPI OpenAI-compatible router (server-side only)
FREELLMAPI_ENABLED=false
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_MODEL=ministral-8b-latest
FREELLMAPI_FREE_TIER_CONFIRMED=false

# Optional: Semantic Scholar API key (raises the shared public rate limit)
SEMANTIC_SCHOLAR_API_KEY=

# ------------------------------------------------------------------------------
# 3. DOCUMENT OCR (Offline, runs locally on CPU)
# ------------------------------------------------------------------------------
OCR_ENABLED=true
OCR_MAX_PAGES=100

# ------------------------------------------------------------------------------
# 4. BACKGROUND WORKER & CACHE (Optional external worker)
# ------------------------------------------------------------------------------
REDIS_URL=

# ------------------------------------------------------------------------------
# 5. FIRESTORE (Vercel production data store; credentials stay server-side)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Set DATA_BACKEND=firestore for persistent hosted data.
FIREBASE_STORAGE_BUCKET=
# Local Firebase Auth only; hosted Google sign-in uses the OAuth client above.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
