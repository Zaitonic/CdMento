# ==============================================================================
# CdMento Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & DATABASE (Local Developer Mode)
# ------------------------------------------------------------------------------
AUTH_MODE=local
DATA_BACKEND=sqlite
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 2. AI GATEWAY (Server-Side)
# ------------------------------------------------------------------------------
AI_ENABLED=true
AI_FREE_TIER_CONFIRMED=false
AI_DAILY_REQUESTS=100
AI_MAX_OUTPUT_TOKENS=2400

# Cloudflare Workers AI (Workers Free)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_FREE_TIER_CONFIRMED=false

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (Requires an explicit :free model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Experimental Local Router: FreeLLMAPI
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_MODEL=ministral-8b-latest
FREELLMAPI_FREE_TIER_CONFIRMED=false

# ------------------------------------------------------------------------------
# 3. DOCUMENT OCR (Offline, runs locally on CPU)
# ------------------------------------------------------------------------------
OCR_ENABLED=true
OCR_MAX_PAGES=100

# ------------------------------------------------------------------------------
# 4. BACKGROUND WORKER & CACHE (Optional external worker)
# ------------------------------------------------------------------------------
REDIS_URL=

# ------------------------------------------------------------------------------
# 5. FIREBASE / CLOUD (Optional - Only needed if AUTH_MODE=firebase)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
