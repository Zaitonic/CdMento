{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "env": {
    "UV_LINK_MODE": "copy"
  },
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "installCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR npm_config_cache-dir NPM_CONFIG_CACHE-DIR; npm ci --loglevel=error --no-audit --no-fund",
      "buildCommand": "npm run build",
      "outputDirectory": "build/web",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app",
      "functions": {
        "**/*.py": {
          "maxDuration": 300,
          "excludeFiles": "{node_modules/**,frontend/**,public/**,build/**,dist/**,.git/**,.cache/**,.ruff_cache/**,.pytest_cache/**,backend/tests/**,backend/data/**,artifacts/**,docs/**,examples/**,scripts/**,.venv/**,.env,.env.*,**/__pycache__/**,.vercel_python_packages/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/brand/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/sw.js",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/manifest.webmanifest",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"}
      ]
    }
  ]
}
