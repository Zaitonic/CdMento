{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "build/web",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app",
      "excludeFiles": [
        "node_modules/**",
        "frontend/**",
        "public/**",
        "build/**",
        "dist/**",
        ".git/**",
        ".cache/**",
        ".ruff_cache/**",
        ".pytest_cache/**",
        "backend/tests/**",
        "backend/data/**",
        "artifacts/**",
        "docs/**",
        "examples/**",
        "scripts/**"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/assets/(.*)", "destination": { "service": "web" } },
    { "source": "/brand/(.*)", "destination": { "service": "web" } },
    { "source": "/sw.js", "destination": { "service": "web" } },
    { "source": "/manifest.webmanifest", "destination": { "service": "web" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
