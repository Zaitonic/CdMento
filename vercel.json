{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "build/web"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/assets/(.*)", "destination": { "service": "web" } },
    { "source": "/brand/(.*)", "destination": { "service": "web" } },
    { "source": "/sw.js", "destination": { "service": "web" } },
    { "source": "/manifest.webmanifest", "destination": { "service": "web" } },
    {
      "source": "/(.*)",
      "destination": { "service": "web", "path": "/index.html" }
    }
  ]
}
